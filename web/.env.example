# policyctl web app — environment variables
# Copy to .env and fill in real values for development.

# API base URL for the control-plane Worker
VITE_API_BASE=https://policyctl-server.shivamkumar10958.workers.dev

# Cloudflare Turnstile site key (public).
# Get from https://dash.cloudflare.com → Turnstile → Widgets
# For local dev, use the Cloudflare test key: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Auth0 (Universal Login) — create an application at https://auth0.com
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
