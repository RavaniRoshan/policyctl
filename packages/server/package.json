{
  "name": "@policyctl/server",
  "version": "0.1.6",
  "type": "module",
  "private": true,
  "description": "policyctl hosted control plane — Cloudflare Workers + D1 (orgs, policy versioning, violation feed).",
  "scripts": {
    "build": "node scripts/build-css.mjs && tsc -p tsconfig.json",
    "dev": "node scripts/build-css.mjs && wrangler dev",
    "deploy": "node scripts/build-css.mjs && wrangler deploy",
    "migrate": "wrangler d1 migrations apply policyctl --remote",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "jose": "^6.2.10",
    "stripe": "^14.0.0",
    "@policyctl/types": "workspace:^0.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.0.0",
    "vitest": "^2.1.8"
  }
}
