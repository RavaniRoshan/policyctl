{
  "name": "policyctl",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "build:worker": "pnpm --filter @policyctl/server build",
    "deploy:worker": "pnpm --filter @policyctl/server deploy",
    "version:worker": "pnpm --filter @policyctl/server exec wrangler versions upload"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "framer-motion": "^13.1.1"
  },
  "devDependencies": {
    "wrangler": "^4.43.0"
  }
}
