---
const { title = "policyctl", description = "Provider-agnostic policy runtime for coding agents." } = Astro.props;
import "../styles/global.css";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono&display=swap" rel="stylesheet" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="border-b border-white/5">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
        <a href="/" class="flex items-center gap-2 text-sm font-semibold tracking-tight">
          <span class="bg-gradient-to-r from-primary-400 to-emerald-300 bg-clip-text text-transparent">policyctl</span>
        </a>
        <nav class="flex items-center gap-6 text-sm text-slate-300">
          <a href="/docs" class="hover:text-white">Docs</a>
          <a href="/#how-it-works" class="hover:text-white">How it works</a>
          <a href="https://github.com/RavaniRoshan/policyctl" class="hover:text-white" target="_blank" rel="noreferrer">GitHub</a>
          <a href="https://www.npmjs.com/package/@policyctl/cli" class="hover:text-white" target="_blank" rel="noreferrer">npm</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="border-t border-white/5 mt-24">
      <div class="mx-auto max-w-6xl px-6 py-8 text-sm text-slate-400 flex justify-between">
        <span>MIT · © 2026 policyctl contributors</span>
        <span>Built for staff engineers running mixed-agent stacks.</span>
      </div>
    </footer>
  </body>
</html>
