---
import Base from "../layouts/Base.astro";
const installBlock = `npm install -g @policyctl/cli
# or, no install:
npx @policyctl/cli check`;
const quickstartBlock = `policyctl init --template full
policyctl list
policyctl gen claude     # or codex / cursor
policyctl check          # gate the diff in CI`;
const ciBlock = `# .github/workflows/policy.yml
name: policyctl
on: [push, pull_request]
jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: '20' }
      - run: npx @policyctl/cli check`;
const hostedBlock = `policyctl login --email you@company.com
policyctl push             # publish your policy
policyctl check --report   # send violations to the feed`;
---
<Base title="docs · policyctl" description="Install and use policyctl.">
  <article class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-4xl font-semibold tracking-tight">policyctl docs</h1>
    <p class="mt-2 text-slate-300">Provider-agnostic policy runtime for coding agents.</p>

    <h2 class="mt-10 text-2xl font-semibold tracking-tight">Install</h2>
    <pre class="code-block mt-3"><code>{installBlock}</code></pre>

    <h2 class="mt-10 text-2xl font-semibold tracking-tight">Quickstart</h2>
    <pre class="code-block mt-3"><code>{quickstartBlock}</code></pre>

    <h2 class="mt-10 text-2xl font-semibold tracking-tight">CI</h2>
    <pre class="code-block mt-3"><code>{ciBlock}</code></pre>

    <h2 class="mt-10 text-2xl font-semibold tracking-tight">Hosted control plane (optional)</h2>
    <pre class="code-block mt-3"><code>{hostedBlock}</code></pre>

    <h2 class="mt-10 text-2xl font-semibold tracking-tight">Rules reference</h2>
    <p class="mt-2 text-slate-300">Match a rule against a tool call (hook) or a git diff (ci)</p>
    <ul class="mt-2 list-disc pl-6 text-slate-300 space-y-1">
      <li><code class="rounded bg-white/5 px-1.5 py-0.5 text-sm font-mono">path</code> — glob over the file the tool touches (hook) or changed files (ci)</li>
      <li><code class="rounded bg-white/5 px-1.5 py-0.5 text-sm font-mono">command</code> — regex over a shell command (e.g. the Bash tool); hook only</li>
      <li><code class="rounded bg-white/5 px-1.5 py-0.5 text-sm font-mono">tool</code> — tool name (exact, or <code class="rounded bg-white/5 px-1.5 py-0.5 text-sm font-mono">/regex/</code>); hook only</li>
      <li><code class="rounded bg-white/5 px-1.5 py-0.5 text-sm font-mono">diff_contains</code> — substring that must be present in the diff; ci only</li>
      <li><code class="rounded bg-white/5 px-1.5 py-0.5 text-sm font-mono">diff_not_contains</code> — substring that must be absent (e.g. a generator signature); ci only</li>
      <li><code class="rounded bg-white/5 px-1.5 py-0.5 text-sm font-mono">diff_regex</code> — regex over the full diff text; ci only</li>
      <li><code class="rounded bg-white/5 px-1.5 py-0.5 text-sm font-mono">diff_paths_glob</code> — glob that must match at least one changed file; ci only</li>
      <li><code class="rounded bg-white/5 px-1.5 py-0.5 text-sm font-mono">diff_paths_not_glob</code> — glob that must match no changed file; ci only</li>
    </ul>

    <p class="mt-6 text-slate-400">For the full schema and examples, see the <a class="text-primary-300 hover:text-primary-200" href="https://github.com/RavaniRoshan/policyctl#readme" target="_blank" rel="noreferrer">README</a>.</p>
  </article>
</Base>
